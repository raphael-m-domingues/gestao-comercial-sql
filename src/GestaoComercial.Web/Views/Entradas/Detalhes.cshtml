@using System.Globalization
@model GestaoComercial.Web.Models.EntradaDetalhesViewModel

@{
    ViewData["Title"] = $"Entrada #{Model.EntradaID}";

    var culturaBrasileira =
        CultureInfo.GetCultureInfo("pt-BR");

    var entradaAberta =
        Model.Status == "ABERTA";

    var quantidadeItens =
        Model.Itens.Count();
}

@if (TempData["MensagemSucesso"] is not null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        @TempData["MensagemSucesso"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Fechar">
        </button>
    </div>
}

@if (TempData["MensagemErro"] is not null)
{
    <div class="alert alert-danger alert-dismissible fade show"
         role="alert">

        @TempData["MensagemErro"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Fechar">
        </button>
    </div>
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <div class="d-flex align-items-center gap-3">
            <h1 class="mb-1">
                Entrada #@Model.EntradaID
            </h1>

            @if (entradaAberta)
            {
                <span class="badge text-bg-warning">
                    Aberta
                </span>
            }
            else
            {
                <span class="badge text-bg-success">
                    Confirmada
                </span>
            }
        </div>

        <p class="text-muted mb-0">
            Recebimento de mercadorias do fornecedor.
        </p>
    </div>

    <a asp-controller="Entradas"
       asp-action="Index"
       class="btn btn-outline-secondary">
        Voltar
    </a>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row">
            <div class="col-md-4 mb-3 mb-md-0">
                <span class="text-muted d-block">
                    Fornecedor
                </span>

                <strong>@Model.Fornecedor</strong>
            </div>

            <div class="col-md-4 mb-3 mb-md-0">
                <span class="text-muted d-block">
                    Responsável
                </span>

                <strong>@Model.Usuario</strong>
            </div>

            <div class="col-md-4">
                <span class="text-muted d-block">
                    Data da entrada
                </span>

                <strong>
                    @Model.DataEntrada.ToString(
                        "dd/MM/yyyy HH:mm",
                        culturaBrasileira
                    )
                </strong>
            </div>
        </div>
    </div>
</div>

@if (entradaAberta)
{
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <strong>Adicionar produto</strong>
        </div>

        <div class="card-body">
            <form asp-controller="Entradas"
                  asp-action="AdicionarItem"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="EntradaID"
                       value="@Model.EntradaID" />

                <div class="row align-items-end">
                    <div class="col-lg-5 mb-3 mb-lg-0">
                        <label for="ProdutoID"
                               class="form-label">
                            Produto
                        </label>

                        <select id="ProdutoID"
                                name="ProdutoID"
                                asp-items="ViewBag.Produtos"
                                class="form-select"
                                required>

                            <option value="">
                                Selecione um produto
                            </option>
                        </select>
                    </div>

                    <div class="col-lg-2 mb-3 mb-lg-0">
                        <label for="Quantidade"
                               class="form-label">
                            Quantidade
                        </label>

                        <input id="Quantidade"
                               name="Quantidade"
                               type="number"
                               min="1"
                               step="1"
                               value="1"
                               class="form-control"
                               required />
                    </div>

                    <div class="col-lg-2 mb-3 mb-lg-0">
                        <label for="CustoUnitario"
                               class="form-label">
                            Custo unitário
                        </label>

                        <div class="input-group">
                            <span class="input-group-text">
                                R$
                            </span>

                            <input id="CustoUnitario"
                                   name="CustoUnitario"
                                   type="text"
                                   inputmode="decimal"
                                   placeholder="0,00"
                                   class="form-control"
                                   required />
                        </div>

                        <div class="form-text">
                            Use vírgula. Exemplo: 4,75
                        </div>
                    </div>

                    <div class="col-lg-3">
                        <button type="submit"
                                class="btn btn-dark w-100">
                            Adicionar
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

<div class="card shadow-sm mb-4">
    <div class="card-header d-flex justify-content-between">
        <strong>Produtos da entrada</strong>

        <span>
            @quantidadeItens
            @(quantidadeItens == 1 ? "item" : "itens")
        </span>
    </div>

    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Produto</th>

                    <th class="text-center">
                        Quantidade
                    </th>

                    <th class="text-end">
                        Custo unitário
                    </th>

                    <th class="text-end">
                        Subtotal
                    </th>

                    @if (entradaAberta)
                    {
                        <th class="text-end">
                            Ações
                        </th>
                    }
                </tr>
            </thead>

            <tbody>
                @if (quantidadeItens == 0)
                {
                    <tr>
                        <td colspan="@(entradaAberta ? 5 : 4)"
                            class="text-center text-muted py-4">

                            Nenhum produto adicionado.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Itens)
                    {
                        var formularioAtualizar =
                            $"atualizar-item-{item.ItemEntradaID}";

                        var custoUnitarioFormatado =
                            item.CustoUnitario.ToString(
                                "0.00",
                                culturaBrasileira
                            );

                        <tr>
                            <td>
                                @item.Produto
                            </td>

                            @if (entradaAberta)
                            {
                                <td>
                                    <input form="@formularioAtualizar"
                                           name="quantidade"
                                           type="number"
                                           min="1"
                                           step="1"
                                           value="@item.Quantidade"
                                           class="form-control text-center"
                                           required />
                                </td>

                                <td>
                                    <input form="@formularioAtualizar"
                                           name="custoUnitario"
                                           type="text"
                                           inputmode="decimal"
                                           value="@custoUnitarioFormatado"
                                           class="form-control text-end"
                                           required />
                                </td>
                            }
                            else
                            {
                                <td class="text-center">
                                    @item.Quantidade
                                </td>

                                <td class="text-end">
                                    @item.CustoUnitario.ToString(
                                        "C",
                                        culturaBrasileira
                                    )
                                </td>
                            }

                            <td class="text-end">
                                @item.Subtotal.ToString(
                                    "C",
                                    culturaBrasileira
                                )
                            </td>

                            @if (entradaAberta)
                            {
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        <form id="@formularioAtualizar"
                                              asp-controller="Entradas"
                                              asp-action="AtualizarItem"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="entradaID"
                                                   value="@Model.EntradaID" />

                                            <input type="hidden"
                                                   name="itemEntradaID"
                                                   value="@item.ItemEntradaID" />

                                            <button type="submit"
                                                    class="btn btn-outline-primary btn-sm">
                                                Salvar
                                            </button>
                                        </form>

                                        <form asp-controller="Entradas"
                                              asp-action="RemoverItem"
                                              method="post"
                                              onsubmit="return confirm('Deseja remover este produto da entrada?');">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="entradaID"
                                                   value="@Model.EntradaID" />

                                            <input type="hidden"
                                                   name="itemEntradaID"
                                                   value="@item.ItemEntradaID" />

                                            <button type="submit"
                                                    class="btn btn-outline-danger btn-sm">
                                                Remover
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>

            <tfoot>
                <tr>
                    <th colspan="@(entradaAberta ? 3 : 2)"
                        class="text-end">
                        Valor total
                    </th>

                    <th class="text-end">
                        @Model.ValorTotal.ToString(
                            "C",
                            culturaBrasileira
                        )
                    </th>

                    @if (entradaAberta)
                    {
                        <th></th>
                    }
                </tr>
            </tfoot>
        </table>
    </div>
</div>

@if (entradaAberta)
{
    <div class="card border-success shadow-sm">
        <div class="card-body d-flex justify-content-between
                    align-items-center flex-wrap gap-3">

            <div>
                <h5 class="mb-1">
                    Confirmar recebimento
                </h5>

                <p class="text-muted mb-0">
                    A confirmação acrescentará as quantidades ao estoque
                    e registrará as movimentações.
                </p>
            </div>

            <form asp-controller="Entradas"
                  asp-action="Confirmar"
                  method="post"
                  onsubmit="return confirm('Confirma o recebimento desta entrada? Esta operação atualizará o estoque.');">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.EntradaID" />

                @if (quantidadeItens == 0)
                {
                    <button type="submit"
                            class="btn btn-success"
                            disabled>
                        Confirmar entrada
                    </button>
                }
                else
                {
                    <button type="submit"
                            class="btn btn-success">
                        Confirmar entrada
                    </button>
                }
            </form>
        </div>
    </div>
}