@model IEnumerable<GestaoComercial.Web.Models.EntradaListagemViewModel>

@{
    ViewData["Title"] = "Entradas";
}

@if (TempData["MensagemSucesso"] is string mensagemSucesso)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">
        @mensagemSucesso

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Fechar">
        </button>
    </div>
}

<div class="d-flex justify-content-between
            align-items-center mb-4">
    <div>
        <h1 class="mb-1">Entradas de mercadorias</h1>

        <p class="text-muted mb-0">
            Recebimentos registrados junto aos fornecedores.
        </p>
    </div>

    <a asp-action="Criar"
       class="btn btn-dark">
        Nova entrada
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Número</th>
                        <th>Fornecedor</th>
                        <th>Responsável</th>
                        <th>Data</th>
                        <th class="text-center">Itens</th>
                        <th class="text-end">Valor total</th>
                        <th class="text-center">Status</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8"
                                class="text-center text-muted py-4">
                                Nenhuma entrada registrada.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var entrada in Model)
                        {
                            <tr>
                                <td>#@entrada.EntradaID</td>

                                <td>@entrada.Fornecedor</td>

                                <td>@entrada.Usuario</td>

                                <td>
                                    @entrada.DataEntrada.ToString(
                                        "dd/MM/yyyy HH:mm"
                                    )
                                </td>

                                <td class="text-center">
                                    @entrada.QuantidadeItens
                                </td>

                                <td class="text-end">
                                    @entrada.ValorTotal.ToString("C")
                                </td>

                                <td class="text-center">
                                    @if (entrada.Status == "ABERTA")
                                    {
                                        <span class="badge text-bg-warning">
                                            Aberta
                                        </span>
                                    }
                                    else if (
                                        entrada.Status == "CONFIRMADA"
                                    )
                                    {
                                        <span class="badge text-bg-success">
                                            Confirmada
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">
                                            Cancelada
                                        </span>
                                    }
                                </td>

                                <td class="text-end">
                                    <a asp-action="Detalhes"
                                       asp-route-id="@entrada.EntradaID"
                                       class="btn btn-sm
                                              btn-outline-primary">
                                        Abrir
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>