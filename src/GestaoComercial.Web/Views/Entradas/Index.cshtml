@model GestaoComercial.Web.Models.EntradaConsultaViewModel

@{
    ViewData["Title"] = "Entradas";

    var paginaInicial =
        Math.Max(1, Model.Pagina - 2);

    var paginaFinal =
        Math.Min(
            Model.TotalPaginas,
            Model.Pagina + 2
        );

    var dataInicialRota =
        Model.DataInicial?
            .ToString("yyyy-MM-dd");

    var dataFinalRota =
        Model.DataFinal?
            .ToString("yyyy-MM-dd");
}

@if (TempData["MensagemSucesso"] is string mensagemSucesso)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">
        @mensagemSucesso

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Fechar">
        </button>
    </div>
}

<div class="d-flex justify-content-between
            align-items-center mb-4">
    <div>
        <h1 class="mb-1">
            Entradas de mercadorias
        </h1>

        <p class="text-muted mb-0">
            Recebimentos registrados junto aos fornecedores.
        </p>
    </div>

    <a asp-action="Criar"
       class="btn btn-dark">
        Nova entrada
    </a>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index"
              method="get">
            <div asp-validation-summary="All"
                 class="text-danger mb-3">
            </div>

            <div class="row g-3">
                <div class="col-12 col-md-6 col-lg-2">
                    <label asp-for="EntradaID"
                           class="form-label">
                        Número
                    </label>

                    <input asp-for="EntradaID"
                           type="number"
                           min="1"
                           class="form-control"
                           placeholder="Ex.: 1001" />
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <label asp-for="FornecedorID"
                           class="form-label">
                        Fornecedor
                    </label>

                    <select asp-for="FornecedorID"
                            asp-items="ViewBag.FornecedoresFiltro"
                            class="form-select">
                        <option value="">
                            Todos
                        </option>
                    </select>
                </div>

                <div class="col-12 col-md-6 col-lg-2">
                    <label asp-for="Status"
                           class="form-label">
                        Status
                    </label>

                    <select asp-for="Status"
                            class="form-select">
                        <option value="TODOS">
                            Todos
                        </option>

                        <option value="ABERTA">
                            Aberta
                        </option>

                        <option value="CONFIRMADA">
                            Confirmada
                        </option>

                        <option value="CANCELADA">
                            Cancelada
                        </option>
                    </select>
                </div>

                <div class="col-12 col-md-6 col-lg-2">
                    <label asp-for="DataInicial"
                           class="form-label">
                        Data inicial
                    </label>

                    <input asp-for="DataInicial"
                           asp-format="{0:yyyy-MM-dd}"
                           type="date"
                           class="form-control" />
                </div>

                <div class="col-12 col-md-6 col-lg-2">
                    <label asp-for="DataFinal"
                           class="form-label">
                        Data final
                    </label>

                    <input asp-for="DataFinal"
                           asp-format="{0:yyyy-MM-dd}"
                           type="date"
                           class="form-control" />
                </div>

                <div class="col-12 col-md-6 col-lg-1">
                    <label asp-for="TamanhoPagina"
                           class="form-label">
                        Itens
                    </label>

                    <select asp-for="TamanhoPagina"
                            class="form-select">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                    </select>
                </div>

                <div class="col-12">
                    <button type="submit"
                            class="btn btn-dark">
                        Filtrar
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Limpar filtros
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Número</th>
                        <th>Fornecedor</th>
                        <th>Responsável</th>
                        <th>Data</th>

                        <th class="text-center">
                            Itens
                        </th>

                        <th class="text-end">
                            Valor total
                        </th>

                        <th class="text-center">
                            Status
                        </th>

                        <th class="text-end">
                            Ações
                        </th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Entradas.Any())
                    {
                        <tr>
                            <td colspan="8"
                                class="text-center text-muted py-4">
                                Nenhuma entrada encontrada.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var entrada in Model.Entradas)
                        {
                            <tr>
                                <td>
                                    #@entrada.EntradaID
                                </td>

                                <td>
                                    @entrada.Fornecedor
                                </td>

                                <td>
                                    @entrada.Usuario
                                </td>

                                <td>
                                    @(
                                        entrada.DataEntrada
                                            .ToString(
                                                "dd/MM/yyyy HH:mm"
                                            )
                                    )
                                </td>

                                <td class="text-center">
                                    @entrada.QuantidadeItens
                                </td>

                                <td class="text-end">
                                    @entrada.ValorTotal.ToString("C")
                                </td>

                                <td class="text-center">
                                    @if (entrada.Status == "ABERTA")
                                    {
                                        <span class="badge text-bg-warning">
                                            Aberta
                                        </span>
                                    }
                                    else if (
                                        entrada.Status == "CONFIRMADA"
                                    )
                                    {
                                        <span class="badge text-bg-success">
                                            Confirmada
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">
                                            Cancelada
                                        </span>
                                    }
                                </td>

                                <td class="text-end">
                                    <a asp-action="Detalhes"
                                       asp-route-id="@entrada.EntradaID"
                                       class="btn btn-sm
                                              btn-outline-primary">
                                        Abrir
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card-footer bg-white">
        <div class="d-flex flex-column flex-md-row
                    justify-content-between align-items-md-center
                    gap-3">
            <div class="text-muted">
                @if (Model.TotalRegistros == 0)
                {
                    <span>
                        Nenhum registro encontrado.
                    </span>
                }
                else
                {
                    <span>
                        Exibindo @Model.PrimeiroRegistro
                        a @Model.UltimoRegistro
                        de @Model.TotalRegistros entradas.
                    </span>
                }
            </div>

            @if (Model.TotalPaginas > 1)
            {
                <nav aria-label="Paginação de entradas">
                    <ul class="pagination mb-0">
                        <li class="page-item
                                   @(Model.Pagina == 1
                                       ? "disabled"
                                       : null)">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-entradaID="@Model.EntradaID"
                               asp-route-fornecedorID="@Model.FornecedorID"
                               asp-route-status="@Model.Status"
                               asp-route-dataInicial="@dataInicialRota"
                               asp-route-dataFinal="@dataFinalRota"
                               asp-route-pagina="@(Model.Pagina - 1)"
                               asp-route-tamanhoPagina="@Model.TamanhoPagina">
                                Anterior
                            </a>
                        </li>

                        @for (
                            var pagina = paginaInicial;
                            pagina <= paginaFinal;
                            pagina++
                        )
                        {
                            <li class="page-item
                                       @(pagina == Model.Pagina
                                           ? "active"
                                           : null)">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-entradaID="@Model.EntradaID"
                                   asp-route-fornecedorID="@Model.FornecedorID"
                                   asp-route-status="@Model.Status"
                                   asp-route-dataInicial="@dataInicialRota"
                                   asp-route-dataFinal="@dataFinalRota"
                                   asp-route-pagina="@pagina"
                                   asp-route-tamanhoPagina="@Model.TamanhoPagina">
                                    @pagina
                                </a>
                            </li>
                        }

                        <li class="page-item
                                   @(Model.Pagina == Model.TotalPaginas
                                       ? "disabled"
                                       : null)">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-entradaID="@Model.EntradaID"
                               asp-route-fornecedorID="@Model.FornecedorID"
                               asp-route-status="@Model.Status"
                               asp-route-dataInicial="@dataInicialRota"
                               asp-route-dataFinal="@dataFinalRota"
                               asp-route-pagina="@(Model.Pagina + 1)"
                               asp-route-tamanhoPagina="@Model.TamanhoPagina">
                                Próxima
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>