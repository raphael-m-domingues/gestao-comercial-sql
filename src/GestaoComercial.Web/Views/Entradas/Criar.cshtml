@model GestaoComercial.Web.Models.EntradaCriarViewModel

@{
    ViewData["Title"] = "Nova entrada";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="d-flex justify-content-between
                    align-items-center mb-4">
            <div>
                <h1 class="mb-1">Nova entrada</h1>

                <p class="text-muted mb-0">
                    Selecione o fornecedor e o responsável
                    pelo recebimento.
                </p>
            </div>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Voltar
            </a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Criar" method="post">
                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">
                        <label asp-for="FornecedorID"
                               class="form-label">
                        </label>

                        <select asp-for="FornecedorID"
                                asp-items="ViewBag.Fornecedores"
                                class="form-select">
                            <option value="">
                                Selecione um fornecedor
                            </option>
                        </select>

                        <span asp-validation-for="FornecedorID"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="UsuarioID"
                               class="form-label">
                        </label>

                        <select asp-for="UsuarioID"
                                asp-items="ViewBag.Usuarios"
                                class="form-select">
                            <option value="">
                                Selecione um usuário
                            </option>
                        </select>

                        <span asp-validation-for="UsuarioID"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="alert alert-info">
                        A entrada será criada com o status
                        <strong>Aberta</strong>. Depois será possível
                        adicionar os produtos antes da confirmação.
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancelar
                        </a>

                        <button type="submit"
                                class="btn btn-dark">
                            Criar entrada
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}