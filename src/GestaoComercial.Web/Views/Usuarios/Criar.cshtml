@model GestaoComercial.Web.Models.UsuarioCriarViewModel

@{
    ViewData["Title"] = "Novo usuário";
}

<div class="d-flex justify-content-between
            align-items-start mb-4">
    <div>
        <h1 class="mb-1">
            Novo usuário
        </h1>

        <p class="text-muted mb-0">
            Cadastre uma conta e defina seu perfil de acesso.
        </p>
    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary">
        Voltar
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Criar"
              method="post">
            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Nome"
                           class="form-label">
                    </label>

                    <input asp-for="Nome"
                           class="form-control"
                           autocomplete="name" />

                    <span asp-validation-for="Nome"
                          class="text-danger">
                    </span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Email"
                           class="form-label">
                    </label>

                    <input asp-for="Email"
                           class="form-control"
                           autocomplete="email" />

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="PerfilID"
                           class="form-label">
                    </label>

                    <select asp-for="PerfilID"
                            asp-items="ViewBag.Perfis"
                            class="form-select">
                        <option value="">
                            Selecione um perfil
                        </option>
                    </select>

                    <span asp-validation-for="PerfilID"
                          class="text-danger">
                    </span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="Senha"
                           class="form-label">
                    </label>

                    <input asp-for="Senha"
                           class="form-control"
                           autocomplete="new-password" />

                    <span asp-validation-for="Senha"
                          class="text-danger">
                    </span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="ConfirmarSenha"
                           class="form-label">
                    </label>

                    <input asp-for="ConfirmarSenha"
                           class="form-control"
                           autocomplete="new-password" />

                    <span asp-validation-for="ConfirmarSenha"
                          class="text-danger">
                    </span>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancelar
                </a>

                <button type="submit"
                        class="btn btn-dark">
                    Cadastrar usuário
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}