@model GestaoComercial.Web.Models.ProdutoFormularioViewModel

@{
    ViewData["Title"] = "Editar produto";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between
                    align-items-center mb-4">
            <div>
                <h1>Editar produto</h1>
                <p class="text-muted mb-0">
                    Atualize os dados cadastrais do produto.
                </p>
            </div>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Voltar
            </a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Editar"
                      asp-route-id="@Model.ProdutoID"
                      method="post">

                    <input asp-for="ProdutoID" type="hidden" />

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="row">
                        <div class="col-md-7 mb-3">
                            <label asp-for="Nome"
                                   class="form-label">
                            </label>

                            <input asp-for="Nome"
                                   class="form-control"
                                   maxlength="120"
                                   autofocus />

                            <span asp-validation-for="Nome"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-5 mb-3">
                            <label asp-for="CategoriaID"
                                   class="form-label">
                            </label>

                            <select asp-for="CategoriaID"
                                    asp-items="ViewBag.Categorias"
                                    class="form-select">
                                <option value="">
                                    Selecione uma categoria
                                </option>
                            </select>

                            <span asp-validation-for="CategoriaID"
                                  class="text-danger">
                            </span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CodigoBarras"
                               class="form-label">
                        </label>

                        <input asp-for="CodigoBarras"
                               class="form-control"
                               maxlength="14" />

                        <span asp-validation-for="CodigoBarras"
                              class="text-danger">
                        </span>

                        <div class="form-text">
                            Campo opcional. Informe somente os números
                            do código.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descricao"
                               class="form-label">
                        </label>

                        <textarea asp-for="Descricao"
                                  class="form-control"
                                  rows="3"
                                  maxlength="255">
                        </textarea>

                        <span asp-validation-for="Descricao"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="PrecoCusto"
                                   class="form-label">
                            </label>

                            <div class="input-group">
                                <span class="input-group-text">R$</span>

                                <input asp-for="PrecoCusto"
                                       class="form-control"
                                       type="number"
                                       min="0"
                                       max="99999999.99"
                                       step="0.01" />
                            </div>

                            <span asp-validation-for="PrecoCusto"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="PrecoVenda"
                                   class="form-label">
                            </label>

                            <div class="input-group">
                                <span class="input-group-text">R$</span>

                                <input asp-for="PrecoVenda"
                                       class="form-control"
                                       type="number"
                                       min="0"
                                       max="99999999.99"
                                       step="0.01" />
                            </div>

                            <span asp-validation-for="PrecoVenda"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="EstoqueMinimo"
                                   class="form-label">
                            </label>

                            <input asp-for="EstoqueMinimo"
                                   class="form-control"
                                   type="number"
                                   min="0"
                                   step="1" />

                            <span asp-validation-for="EstoqueMinimo"
                                  class="text-danger">
                            </span>
                        </div>
                    </div>

                    <div class="alert alert-secondary">
                        A quantidade atual em estoque não é alterada
                        nesta tela.
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancelar
                        </a>

                        <button type="submit"
                                class="btn btn-dark">
                            Salvar alterações
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}