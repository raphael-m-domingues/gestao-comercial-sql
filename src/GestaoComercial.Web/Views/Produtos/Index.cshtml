@model GestaoComercial.Web.Models.ProdutoConsultaViewModel

@{
    ViewData["Title"] = "Produtos";

    var podeGerenciar =
        User.IsInRole("Administrador")
        || User.IsInRole("Estoquista");

    var quantidadeColunas =
        podeGerenciar ? 8 : 6;

    var paginaInicial =
        Math.Max(1, Model.Pagina - 2);

    var paginaFinal =
        Math.Min(
            Model.TotalPaginas,
            Model.Pagina + 2
        );
}

@if (TempData["MensagemSucesso"] is string mensagem)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">
        @mensagem

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Fechar">
        </button>
    </div>
}

<div class="d-flex justify-content-between
            align-items-center mb-4">
    <div>
        <h1 class="mb-1">
            Produtos
        </h1>

        <p class="text-muted mb-0">
            Consulta de produtos, preços e quantidades em estoque.
        </p>
    </div>

    @if (podeGerenciar)
    {
        <a asp-action="Criar"
           class="btn btn-dark">
            Novo produto
        </a>
    }
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index"
              method="get">
            <div class="row g-3">
                <div class="col-12 col-lg-4">
                    <label asp-for="Busca"
                           class="form-label">
                        Produto ou código de barras
                    </label>

                    <input asp-for="Busca"
                           class="form-control"
                           placeholder="Digite para pesquisar" />
                </div>

                <div class="col-12 col-md-6 col-lg-2">
                    <label asp-for="CategoriaID"
                           class="form-label">
                        Categoria
                    </label>

                    <select asp-for="CategoriaID"
                            asp-items="ViewBag.CategoriasFiltro"
                            class="form-select">
                        <option value="">
                            Todas
                        </option>
                    </select>
                </div>

                <div class="col-12 col-md-6 col-lg-2">
                    <label asp-for="Status"
                           class="form-label">
                        Cadastro
                    </label>

                    <select asp-for="Status"
                            class="form-select">
                        <option value="TODOS">
                            Todos
                        </option>

                        <option value="ATIVOS">
                            Ativos
                        </option>

                        <option value="INATIVOS">
                            Inativos
                        </option>
                    </select>
                </div>

                <div class="col-12 col-md-6 col-lg-2">
                    <label asp-for="SituacaoEstoque"
                           class="form-label">
                        Situação do estoque
                    </label>

                    <select asp-for="SituacaoEstoque"
                            class="form-select">
                        <option value="TODOS">
                            Todas
                        </option>

                        <option value="SEM_ESTOQUE">
                            Sem estoque
                        </option>

                        <option value="ESTOQUE_BAIXO">
                            Estoque baixo
                        </option>

                        <option value="NORMAL">
                            Normal
                        </option>
                    </select>
                </div>

                <div class="col-12 col-md-6 col-lg-2">
                    <label asp-for="TamanhoPagina"
                           class="form-label">
                        Itens por página
                    </label>

                    <select asp-for="TamanhoPagina"
                            class="form-select">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                    </select>
                </div>

                <div class="col-12">
                    <button type="submit"
                            class="btn btn-dark">
                        Filtrar
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Limpar filtros
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Produto</th>

                        <th>Categoria</th>

                        @if (podeGerenciar)
                        {
                            <th class="text-end">
                                Preço de custo
                            </th>
                        }

                        <th class="text-end">
                            Preço de venda
                        </th>

                        <th class="text-center">
                            Estoque
                        </th>

                        <th class="text-center">
                            Situação
                        </th>

                        <th class="text-center">
                            Cadastro
                        </th>

                        @if (podeGerenciar)
                        {
                            <th class="text-end">
                                Ações
                            </th>
                        }
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Produtos.Any())
                    {
                        <tr>
                            <td colspan="@quantidadeColunas"
                                class="text-center text-muted py-4">
                                Nenhum produto encontrado.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var produto in Model.Produtos)
                        {
                            <tr>
                                <td>
                                    @produto.Nome
                                </td>

                                <td>
                                    @produto.Categoria
                                </td>

                                @if (podeGerenciar)
                                {
                                    <td class="text-end">
                                        @produto.PrecoCusto.ToString("C")
                                    </td>
                                }

                                <td class="text-end">
                                    @produto.PrecoVenda.ToString("C")
                                </td>

                                <td class="text-center">
                                    @produto.QuantidadeAtual
                                </td>

                                <td class="text-center">
                                    @if (produto.QuantidadeAtual == 0)
                                    {
                                        <span class="badge text-bg-danger">
                                            Sem estoque
                                        </span>
                                    }
                                    else if (
                                        produto.QuantidadeAtual
                                        <= produto.EstoqueMinimo
                                    )
                                    {
                                        <span class="badge text-bg-warning">
                                            Estoque baixo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-success">
                                            Normal
                                        </span>
                                    }
                                </td>

                                <td class="text-center">
                                    @if (produto.Ativo)
                                    {
                                        <span class="badge text-bg-success">
                                            Ativo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">
                                            Inativo
                                        </span>
                                    }
                                </td>

                                @if (podeGerenciar)
                                {
                                    <td class="text-end text-nowrap">
                                        <a asp-action="Editar"
                                           asp-route-id="@produto.ProdutoID"
                                           class="btn btn-sm
                                                  btn-outline-primary">
                                            Editar
                                        </a>

                                        <form asp-action="AlterarStatus"
                                              method="post"
                                              class="d-inline">
                                            <input type="hidden"
                                                   name="id"
                                                   value="@produto.ProdutoID" />

                                            <input type="hidden"
                                                   name="ativo"
                                                   value="@(!produto.Ativo)" />

                                            <input type="hidden"
                                                   name="busca"
                                                   value="@Model.Busca" />

                                            <input type="hidden"
                                                   name="categoriaID"
                                                   value="@Model.CategoriaID" />

                                            <input type="hidden"
                                                   name="status"
                                                   value="@Model.Status" />

                                            <input type="hidden"
                                                   name="situacaoEstoque"
                                                   value="@Model.SituacaoEstoque" />

                                            <input type="hidden"
                                                   name="pagina"
                                                   value="@Model.Pagina" />

                                            <input type="hidden"
                                                   name="tamanhoPagina"
                                                   value="@Model.TamanhoPagina" />

                                            @if (produto.Ativo)
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm
                                                               btn-outline-danger">
                                                    Desativar
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm
                                                               btn-outline-success">
                                                    Ativar
                                                </button>
                                            }
                                        </form>
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card-footer bg-white">
        <div class="d-flex flex-column flex-md-row
                    justify-content-between align-items-md-center
                    gap-3">
            <div class="text-muted">
                @if (Model.TotalRegistros == 0)
                {
                    <span>
                        Nenhum registro encontrado.
                    </span>
                }
                else
                {
                    <span>
                        Exibindo @Model.PrimeiroRegistro
                        a @Model.UltimoRegistro
                        de @Model.TotalRegistros produtos.
                    </span>
                }
            </div>

            @if (Model.TotalPaginas > 1)
            {
                <nav aria-label="Paginação de produtos">
                    <ul class="pagination mb-0">
                        <li class="page-item
                                   @(Model.Pagina == 1
                                       ? "disabled"
                                       : null)">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-busca="@Model.Busca"
                               asp-route-categoriaID="@Model.CategoriaID"
                               asp-route-status="@Model.Status"
                               asp-route-situacaoEstoque="@Model.SituacaoEstoque"
                               asp-route-pagina="@(Model.Pagina - 1)"
                               asp-route-tamanhoPagina="@Model.TamanhoPagina">
                                Anterior
                            </a>
                        </li>

                        @for (
                            var pagina = paginaInicial;
                            pagina <= paginaFinal;
                            pagina++
                        )
                        {
                            <li class="page-item
                                       @(pagina == Model.Pagina
                                           ? "active"
                                           : null)">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-busca="@Model.Busca"
                                   asp-route-categoriaID="@Model.CategoriaID"
                                   asp-route-status="@Model.Status"
                                   asp-route-situacaoEstoque="@Model.SituacaoEstoque"
                                   asp-route-pagina="@pagina"
                                   asp-route-tamanhoPagina="@Model.TamanhoPagina">
                                    @pagina
                                </a>
                            </li>
                        }

                        <li class="page-item
                                   @(Model.Pagina == Model.TotalPaginas
                                       ? "disabled"
                                       : null)">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-busca="@Model.Busca"
                               asp-route-categoriaID="@Model.CategoriaID"
                               asp-route-status="@Model.Status"
                               asp-route-situacaoEstoque="@Model.SituacaoEstoque"
                               asp-route-pagina="@(Model.Pagina + 1)"
                               asp-route-tamanhoPagina="@Model.TamanhoPagina">
                                Próxima
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>