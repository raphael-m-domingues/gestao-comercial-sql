@model GestaoComercial.Web.Models.VendaCriarViewModel

@{
    ViewData["Title"] = "Nova venda";
}

<div class="d-flex justify-content-between
            align-items-start mb-4">
    <div>
        <h1 class="mb-1">
            Nova venda
        </h1>

        <p class="text-muted mb-0">
            Selecione a forma de pagamento.
        </p>
    </div>

    <a asp-controller="Vendas"
       asp-action="Index"
       class="btn btn-outline-secondary">
        Voltar
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-controller="Vendas"
              asp-action="Criar"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="mb-4">
                <label asp-for="FormaPagamentoID"
                       class="form-label">
                </label>

                <select asp-for="FormaPagamentoID"
                        asp-items="ViewBag.FormasPagamento"
                        class="form-select">
                    <option value="0">
                        Selecione uma forma de pagamento
                    </option>
                </select>

                <span asp-validation-for="FormaPagamentoID"
                      class="text-danger">
                </span>
            </div>

            <div class="alert alert-info">
                <p class="mb-2">
                    O responsável será o usuário atualmente
                    conectado:
                    <strong>@User.Identity?.Name</strong>.
                </p>

                <p class="mb-0">
                    A venda será criada com o status
                    <strong>Aberta</strong>. Depois será possível
                    adicionar os produtos antes da conclusão.
                </p>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-controller="Vendas"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancelar
                </a>

                <button type="submit"
                        class="btn btn-dark">
                    Criar venda
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}